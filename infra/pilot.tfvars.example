vpc_id                 = "vpc-REPLACE"
public_subnet_ids      = ["subnet-public-a", "subnet-public-c"]
db_subnet_ids          = ["subnet-private-db-a", "subnet-private-db-c"]
route53_zone_id        = "Z-REPLACE"
app_domain             = "pilot.example.kr"
ops_domain             = "ops.example.kr"
api_origin_domain      = "api-origin.example.kr"
viewer_certificate_arn = "arn:aws:acm:us-east-1:000000000000:certificate/REPLACE"
alb_certificate_arn    = "arn:aws:acm:ap-northeast-2:000000000000:certificate/REPLACE"
mail_domain            = "example.kr"
mail_from_domain       = "bounce.example.kr"

# Supply these exact keys as existing SSM SecureString parameter ARNs.
app_secret_parameter_arns = {
  DATABASE_URL                    = "arn:aws:ssm:ap-northeast-2:000000000000:parameter/sportsgrow/pilot/DATABASE_URL"
  LEGAL_ENTITY_NAME               = "arn:aws:ssm:ap-northeast-2:000000000000:parameter/sportsgrow/pilot/LEGAL_ENTITY_NAME"
  LEGAL_REPRESENTATIVE            = "arn:aws:ssm:ap-northeast-2:000000000000:parameter/sportsgrow/pilot/LEGAL_REPRESENTATIVE"
  LEGAL_ADDRESS                   = "arn:aws:ssm:ap-northeast-2:000000000000:parameter/sportsgrow/pilot/LEGAL_ADDRESS"
  LEGAL_BUSINESS_NUMBER           = "arn:aws:ssm:ap-northeast-2:000000000000:parameter/sportsgrow/pilot/LEGAL_BUSINESS_NUMBER"
  LEGAL_ECOMMERCE_REGISTRATION    = "arn:aws:ssm:ap-northeast-2:000000000000:parameter/sportsgrow/pilot/LEGAL_ECOMMERCE_REGISTRATION"
  SUPPORT_EMAIL                   = "arn:aws:ssm:ap-northeast-2:000000000000:parameter/sportsgrow/pilot/SUPPORT_EMAIL"
  MAIL_FROM                       = "arn:aws:ssm:ap-northeast-2:000000000000:parameter/sportsgrow/pilot/MAIL_FROM"
}

migrate_database_parameter_arn          = "arn:aws:ssm:ap-northeast-2:000000000000:parameter/sportsgrow/pilot/MIGRATE_DATABASE_URL"
app_database_password_parameter_arn     = "arn:aws:ssm:ap-northeast-2:000000000000:parameter/sportsgrow/pilot/APP_DATABASE_PASSWORD"
report_database_password_parameter_arn  = "arn:aws:ssm:ap-northeast-2:000000000000:parameter/sportsgrow/pilot/REPORT_DATABASE_PASSWORD"
secret_kms_key_arns                     = ["arn:aws:kms:ap-northeast-2:000000000000:key/REPLACE"]

# Keep the initial service stopped until the bootstrap/migration task succeeds.
api_desired_count = 0
api_image_tag     = "bootstrap"

# db_master_password is supplied via TF_VAR_db_master_password, never in this file.
